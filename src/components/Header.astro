---
import { CATEGORY_LIST } from '~/lib/categories';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) ? 'page' : undefined;
---

<header class="hdr">
  <div class="wrap hdr__in">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true"></span>
      AI Report
    </a>

    <nav class="nav" aria-label="주요 메뉴">
      {
        CATEGORY_LIST.map((c) => (
          <a href={`/${c.id}/`} aria-current={isCurrent(`/${c.id}/`)}>
            <span class="nav__full">{c.name}</span>
            <span class="nav__short">{c.short}</span>
          </a>
        ))
      }
      <a href="/archive/" aria-current={isCurrent('/archive/')}>아카이브</a>

    </nav>

    <button id="theme-toggle" class="icon-btn" type="button" aria-label="다크 모드로 전환">
      <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
  </div>
</header>
