---
import { CATEGORY_GROUPS, CATEGORIES } from '~/lib/categories';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) ? 'page' : undefined;
const groups = CATEGORY_GROUPS.map((g) => ({
  label: g.label,
  cats: g.ids.map((id) => CATEGORIES[id]),
}));
const groupActive = (cats: { id: string }[]) => cats.some((c) => path.startsWith(`/${c.id}/`));
---

<header class="hdr">
  <div class="wrap hdr__in">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true"></span>
      AI Report
    </a>

    <nav class="nav" aria-label="주요 메뉴">
      {
        groups.map((g) => (
          <details class="nav-group" data-nav-group>
            <summary class="nav-group__btn" data-active={groupActive(g.cats) ? '' : undefined}>
              <span>{g.label}</span>
              <svg class="nav-group__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <ul class="nav-group__menu">
              {g.cats.map((c) => (
                <li>
                  <a href={`/${c.id}/`} aria-current={isCurrent(`/${c.id}/`)}>
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
      <a class="nav-link" href="/archive/" aria-current={isCurrent('/archive/')}>아카이브</a>
    </nav>

    <button id="theme-toggle" class="icon-btn" type="button" aria-label="다크 모드로 전환">
      <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  // GNB 그룹 드롭다운(<details>) 보강: 열기 시 다른 그룹 닫기 · Escape · 바깥 클릭.
  // 토글/키보드/aria 는 네이티브 <details>/<summary> 가 처리한다(무프레임워크).
  (() => {
    const groups = Array.from(document.querySelectorAll('[data-nav-group]'));
    if (!groups.length) return;
    for (const d of groups) {
      d.addEventListener('toggle', () => {
        if (d.open) for (const o of groups) if (o !== d) o.open = false;
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = groups.find((d) => d.open);
      if (!open) return;
      open.open = false;
      open.querySelector('summary')?.focus();
    });
    document.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('[data-nav-group]')) return;
      for (const d of groups) d.open = false;
    });
  })();
</script>
