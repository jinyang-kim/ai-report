---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ReportCard from '~/components/ReportCard.astro';
import { CATEGORY_LIST } from '~/lib/categories';
import { getAllReports, groupByDate, formatDate, readingMinutes } from '~/lib/reports';
import { websiteSchema, collectionSchema } from '~/lib/schema';

const all = await getAllReports();
const days = groupByDate(all);
const [latest, ...previous] = days;
const recent = previous.slice(0, 4);
const hasMore = previous.length > recent.length;

// 최신 날짜에서 대표 1건을 피처드로 (조치 필요 alert 우선, 없으면 첫 카테고리).
const featured = latest ? (latest.items.find((r) => r.entry.data.alert) ?? latest.items[0]!) : null;
const latestRest = latest ? latest.items.filter((r) => r !== featured) : [];

const site = Astro.site!;
const jsonLd = [
  websiteSchema(site),
  collectionSchema(site, {
    name: 'AI Report — 최신 브리핑',
    description: '평일 아침마다 자동으로 생성되는 열 개 주제 브리핑의 최신 목록입니다.',
    path: '/',
    reports: all,
  }),
];
---

<BaseLayout
  title="AI Report"
  description="시사·경제, 기술, 컬처·라이프 세 갈래로 나눈 열 개 주제를 평일 아침마다 자동으로 생성해 쌓는 리포트 아카이브입니다."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow">Daily briefing archive</p>
      <h1>매일 아침, 세 갈래의 브리핑</h1>
      <p>
        시사·경제, 기술, 컬처·라이프 — 열 개 주제를 평일 아침마다 자동으로 정리해 이곳에
        쌓습니다. 모든 수치에는 출처와 측정 시점을 붙이고, 확인되지 않은 것은
        확인되지 않았다고 적습니다.
      </p>
      <div class="hero__meta">
        {latest && <span>최신 업데이트 · {formatDate(latest.date, { weekday: true })}</span>}
        <span>총 {all.length}개 리포트</span>
        <a class="section__more" href="/rss.xml">RSS 구독 →</a>
      </div>
    </div>
  </section>

  {
    all.length === 0 ? (
      <section class="section">
        <div class="wrap">
          <div class="empty">
            <h2>아직 리포트가 없습니다</h2>
            <p>
              예약 작업이 처음 실행되면 이곳에 브리핑이 쌓이기 시작합니다. 평일 오전 9시(KST)에
              세 개의 리포트가 자동으로 추가됩니다.
            </p>
          </div>
        </div>
      </section>
    ) : (
      <>
        {featured && (
          <section class="section featured-sec">
            <div class="wrap">
              <a class={`featured card--${featured.categoryId}`} href={featured.href}>
                <div class="featured__top">
                  <span class={`chip chip--${featured.categoryId}`}>{featured.category.name}</span>
                  {featured.entry.data.alert && <span class="chip chip--alert">🔔 조치 필요</span>}
                  <span class="featured__meta">
                    {formatDate(featured.date, { weekday: true })} · 약 {readingMinutes(featured.entry)}분
                  </span>
                </div>
                <h2 class="featured__title">{featured.entry.data.title}</h2>
                <p class="featured__summary">{featured.entry.data.summary}</p>
                {featured.entry.data.highlights[0] && (
                  <p class="featured__hl">{featured.entry.data.highlights[0]}</p>
                )}
                <span class="featured__cta">브리핑 읽기 →</span>
              </a>
            </div>
          </section>
        )}

        {latest && latest.items.length > 1 && (
          <section class="section glance-sec">
            <div class="wrap">
              <div class="section__head">
                <h2>오늘 한눈에</h2>
              </div>
              <ol class="glance">
                {latest.items.map((r) => (
                  <li>
                    <a class="glance__row" href={r.href}>
                      <span class={`chip chip--${r.categoryId}`}>{r.category.short}</span>
                      <span class="glance__text">{r.entry.data.highlights[0] ?? r.entry.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )}

        {latestRest.length > 0 && (
          <section class="section">
            <div class="wrap">
              <div class="section__head">
                <div>
                  <h2>가장 최근 브리핑</h2>
                  <p>{formatDate(latest!.date, { weekday: true })}</p>
                </div>
              </div>
              <div class="grid grid--3">
                {latestRest.map((r) => (
                  <ReportCard report={r} />
                ))}
              </div>
            </div>
          </section>
        )}

        {recent.length > 0 && (
          <section class="section">
            <div class="wrap">
              <div class="section__head">
                <h2>지난 브리핑</h2>
                {hasMore && (
                  <a class="section__more" href="/archive/">
                    전체 아카이브 →
                  </a>
                )}
              </div>

              {recent.map((day) => (
                <div class="day">
                  <div class="day__head">
                    <span class="day__date">{formatDate(day.date, { weekday: true })}</span>
                    <span class="day__count">{day.items.length}개</span>
                  </div>
                  <div class="grid grid--3">
                    {day.items.map((r) => (
                      <ReportCard report={r} maxHighlights={2} />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2>브리핑 종류</h2>
      </div>
      <div class="grid grid--3">
        {
          CATEGORY_LIST.map((c) => (
            <a class={`card card--${c.id}`} href={`/${c.id}/`}>
              <div class="card__top">
                <span class={`chip chip--${c.id}`}>{c.short}</span>
                <span class="card__date">
                  {all.filter((r) => r.categoryId === c.id).length}개
                </span>
              </div>
              <h3>{c.name}</h3>
              <p class="card__summary">{c.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
