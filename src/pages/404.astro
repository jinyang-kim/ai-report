---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청하신 페이지가 존재하지 않습니다.">
  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow">404</p>
      <h1>페이지를 찾을 수 없습니다</h1>
      <p>주소가 바뀌었거나 삭제된 리포트일 수 있습니다.</p>
      <div class="hero__meta">
        <a class="section__more" href="/">홈으로 →</a>
        <a class="section__more" href="/archive/">전체 아카이브 →</a>
      </div>
    </div>
  </section>
</BaseLayout>
